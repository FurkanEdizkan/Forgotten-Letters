# ─────────────────────────────────────────────────────────────────────────────
# Forgotten Letters — environment variables
# Copy to `.env.local` for development. Never commit real secrets.
# See docs/Deployment.md for where each value comes from.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ── Database (PostgreSQL + Drizzle) ──────────────────────────────────────────
# Local dev points at the docker-compose Postgres; prod points at your RDS/box.
DATABASE_URL="postgresql://forgotten:forgotten@localhost:5432/forgotten_letters"

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth (https://console.cloud.google.com/ → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Object storage (S3-compatible: MinIO locally, Cloudflare R2 in prod) ─────
# The values below are the LOCAL defaults and work as-is against the MinIO
# service in .devcontainer/docker-compose.yml. Identical app code runs in both
# environments — only these variables change. Prod values are commented out.
#
# R2 dashboard → Manage R2 API Tokens.
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
# S3 endpoint. Local: MinIO. Prod: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT="http://localhost:9000"
# MinIO serves buckets as a path (host/bucket/key); R2 uses virtual-host style
# (bucket.host/key). Must be true locally, false in prod.
R2_FORCE_PATH_STYLE="true"
# R2 ignores region but the S3 SDK requires one to be set.
R2_REGION="auto"
# Only needed for prod R2; unused by MinIO.
R2_ACCOUNT_ID=""
R2_BUCKET_ASSETS="forgotten-letters-assets"
R2_BUCKET_AVATARS="forgotten-letters-avatars"
# Public base URL for assets. Local: MinIO's public assets bucket.
# Prod: the Cloudflare custom domain in front of the bucket.
NEXT_PUBLIC_ASSET_BASE_URL="http://localhost:9000/forgotten-letters-assets"
# Per-user storage quota in bytes (default 50 MB free tier — overridden by entitlements)
STORAGE_QUOTA_FREE_BYTES="52428800"

# ── Email (SMTP: Mailpit locally, Amazon SES in prod) ────────────────────────
# Defaults target the Mailpit container — read delivered mail at
# http://localhost:8025. Mailpit accepts any credentials and needs no TLS.
# Prod: SES SMTP credentials (email-smtp.<region>.amazonaws.com, port 587).
SES_SMTP_HOST="localhost"
SES_SMTP_PORT="1025"
SES_SMTP_USER=""
SES_SMTP_PASSWORD=""
# Must be false for Mailpit's plaintext SMTP; true for SES on 587.
SES_SMTP_SECURE="false"
EMAIL_FROM="Forgotten Letters <no-reply@example.com>"

# ── Payments (Stripe — supporter tiers) ──────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price IDs for the supporter tiers (see docs/Monetization.md)
STRIPE_PRICE_VETERAN_MONTHLY=""
STRIPE_PRICE_VETERAN_YEARLY=""
STRIPE_PRICE_CARTOGRAPHER_MONTHLY=""
STRIPE_PRICE_CARTOGRAPHER_YEARLY=""

# ── Donations (zero-integration supporter badge) ─────────────────────────────
NEXT_PUBLIC_GITHUB_SPONSORS_URL="https://github.com/sponsors/your-org"
NEXT_PUBLIC_KOFI_URL="https://ko-fi.com/your-handle"
# Optional: Ko-fi webhook token to auto-grant supporter badges
KOFI_WEBHOOK_TOKEN=""

# ── Ads ──────────────────────────────────────────────────────────────────────
# EthicalAds / Carbon (primary, privacy-friendly — no consent needed)
NEXT_PUBLIC_ETHICALADS_PUBLISHER=""
# Google AdSense (fallback — only served after cookie consent)
NEXT_PUBLIC_ADSENSE_CLIENT=""

# ── AI Forge providers (image gen + STL re-mesh) ─────────────────────────────
# Swap these for whichever providers you wire up; keys are server-only.
AI_IMAGE_PROVIDER_API_KEY=""
AI_MESH_PROVIDER_API_KEY=""
# Credits charged per forge action (see Forge design)
FORGE_CREDITS_PER_IMAGE="1"
FORGE_CREDITS_PER_STL="2"

# ── Rate limiting (rate-limiter-flexible, Postgres-backed) ───────────────────
# Reuses DATABASE_URL by default; set a separate store here if desired.
RATE_LIMIT_STORE_URL=""
