# Forgotten Letters settings. Copy to .env next to compose.yaml and edit; defaults suit a LAN install.
# Secrets may instead be given as a file path in <NAME>_FILE (e.g. POSTGRES_PASSWORD_FILE=/run/secrets/db).
# There are no owner credentials here: open the app in a browser and follow the setup wizard to create the owner.

# --- Required -------------------------------------------------------------------------------------------------

# Database password, shared by the db and app containers. Set it once: changing it later does not change an
# existing database. Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# The address people type into their browser; used in invite links and the "Setup is open at" log line.
#   LAN:   http://192.168.1.20:3000   (this machine's address and APP_PORT)
#   HTTPS: https://letters.example.org (the same as DOMAIN)
ORIGIN=http://localhost:3000

# --- HTTPS (optional, profile `https`) ----------------------------------------------------------------------

# Your domain (DNS pointing here, ports 80 and 443 open). Start with: docker compose --profile https up -d
# DOMAIN=letters.example.org
# COMPOSE_PROFILES=https
# Behind Caddy, trust its forwarded client address, and publish the app port on this machine only so nobody can
# reach the app around Caddy with a faked address. Never set ADDRESS_HEADER without the APP_PORT line.
# APP_PORT=127.0.0.1:3000
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# --- Optional -----------------------------------------------------------------------------------------------

# Host port for plain http. With Docker this is the only way to change the port (the settings page shows it).
# APP_PORT=3000

# Without Docker: set to true to keep the port fixed (the settings page then shows it read-only). The Docker image
# already sets it, so leave it out there. Optional; default false.
# PORT_LOCKED=false

# Database: a full connection string, or the parts (the app builds the URL from POSTGRES_* when DATABASE_URL is
# unset). Leave these alone with the bundled db container.
# DATABASE_URL=postgres://letters:password@db:5432/letters
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_USER=letters
# POSTGRES_DB=letters
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=5000

# Key for the stored seat links, at least 16 characters (openssl rand -base64 24). Optional: unset, it is derived
# from the database password. Changing it later turns existing seat links into "old links" to make again.
# LINK_KEY=

# Logging: fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info

# Backups (pg_dump): where they go inside the container (the backups volume), and how many days are kept.
# BACKUP_DIR=/data/backups
# BACKUP_KEEP_DAYS=14

# Where the rules folders are read from (one folder per version: core-1.0.2/, carcass-front-1.0/ ...). Docker
# mounts ./rules (next to compose.yaml) there read-only, so leave it alone with Docker. Optional; default /data/rules.
# RULES_DIR=/data/rules

# Where uploaded files (fighter images) are kept. Docker keeps them on the uploads volume, so leave it alone with
# Docker. Optional; default /data/uploads.
# UPLOADS_DIR=/data/uploads

# How long old records (e.g. the audit log) are kept, in days (at least 7).
# RETENTION_DAYS=180

# Request body cap and seconds to finish open requests on shutdown (adapter-node).
# BODY_SIZE_LIMIT=1M
# SHUTDOWN_TIMEOUT=20

# Run migrations and background jobs at start. Leave on; tests turn it off.
# RUN_STARTUP=true

# production, development or test.
# NODE_ENV=production
