# Copy to .env (build_and_update.sh does this on first run, with random passwords).

# Database password. Set once: changing it later does not change an existing database.
POSTGRES_PASSWORD=change-me
# The Campaign Master's sign-in. Every start makes this account a working Campaign Master with this
# password (creating it if missing, re-enabling it, and re-applying the password if it changed).
# Its password cannot be changed in the app: change it here and restart.
ADMIN_USERNAME=cm
ADMIN_PASSWORD=change-me

# Image name (change it if this machine runs more than one deployment).
IMAGE=forgotten-letters

# Port for plain http (used directly, or behind your own proxy / tunnel).
PORT=3000

# HTTPS: your domain (DNS pointing here, ports 80 and 443 open), and turn on the Caddy service.
# DOMAIN=campaign.example.com
# COMPOSE_PROFILES=https

# Behind the https profile (Caddy): the client address header. build_and_update.sh sets these for you.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# How long the account and admin log keeps entries, in days.
# AUDIT_RETENTION_DAYS=365
