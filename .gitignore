# The books and what we read from them are copyrighted: bring your own copy (design specs are tracked)
/docs/*
!/docs/superpowers/
!/docs/adr/

# The rules folders (one per version: core-1.0.2/, carcass-front-1.0/ …) hold the books' rules: local only,
# mounted into the app per install
/rules/

# The campaign map extracted from the book (local only)
/assets/map/

# Local backups: the old app's git bundle, its settings
/backups/
/.env

# Blender MCP bridge (download: see tools/README) and tool dependencies
/tools/blender-mcp/
node_modules/

# Personal Claude Code settings
.claude/settings.local.json

# Atlas cache (facts, to-do), rebuilt on demand; personal Codex settings
architecture/.atlas/
.codex/

# The built guide (guide/site/), rebuilt by zensical build
/guide/site/

# Python bytecode caches (tools/packs and other scripts)
__pycache__/
