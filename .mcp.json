{
  "mcpServers": {
    "blender": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "tools/blender-mcp/bundle",
        "blender-mcp"
      ],
      "env": {}
    },
    "likec4": {
      "type": "stdio",
      "command": "node",
      "args": [
        "tools/atlas/node_modules/likec4/bin/likec4.mjs",
        "mcp",
        "architecture"
      ],
      "env": {}
    }
  }
}
