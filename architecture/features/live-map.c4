// Feature: the live map. Code: public.ts, snapshot-cache.ts, hub.ts, /api/stream, live.svelte.ts, LiveMap.svelte, lib/fx.
views {
  dynamic view live_map {
    title 'Live map'
    description '''
      **Every screen follows the campaign within a second.** A change anywhere (a battle
      recorded, the weather turned) reaches every phone and the TV without a reload.

      **Decisions**
      - The public snapshot is the only campaign view that leaves the server; Vision cards and
        hidden progress never enter it.
      - Built once per change and shared: a promise memo in the process, Redis across instances,
        keyed by the campaign's generation.
      - Two channels: a change re-sends the whole snapshot; a trigger (a battle result) is a
        one-shot effect every screen plays at the same moment (clock skew is corrected).
      - Live updates go through the hub: Redis pub/sub (cf:bus) when REDIS_URL is set, memory otherwise.
      - The map draws with PixiJS; effects (sky, bombardment, aircraft) load only in the browser.
      - Inside a battle, zooming out below about 55% or panning about 45% of the screen away
        returns to the map; the camera stays where the viewer took it.
    '''
    cm -> cf.app.web.admin 'records a battle'
    cf.app.web.admin -> cf.app.server.campaign 'commitGame'
    cf.app.server.campaign -> cf.db.t_campaign 'writes the game'
    cf.app.web.admin -> cf.app.server.live 'publish(campaign): it changed'
    cf.app.web.admin -> cf.app.server.world 'announceResult: the battle-result effect'
    cf.app.server.world -> cf.app.server.live 'sendTrigger: one-shot, to every screen'
    cf.app.hooks -> cf.app.server.live 'after any write: snapshotStale (bump the generation)'
    cf.app.server.live -> cf.redis 'pub/sub to every instance'
    cf.app.server.live -> cf.app.web.api 'each /api/stream re-sends the snapshot'
    cf.app.web.api -> cf.app.ui.live 'SSE: snapshot (100 ms after a change), clock, trigger'
    cf.app.ui.live -> cf.app.ui.livemap 'new state; the trigger flies to the zone and plays the result'
    cf.app.ui.livemap -> cf.app.ui.fx 'weather, battles, monuments'
    cf.app.ui.livemap -> guest 'the map moves'
  }
}
