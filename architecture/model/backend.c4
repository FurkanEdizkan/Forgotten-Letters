// The server side of the app: the request pipeline and the server-only modules (app/src/lib/server).
// Rule: routes call these modules; a route queries the database itself only where no module owns that data yet.
model {
  extend cf.app {
    hooks = module 'Request pipeline' {
      #server-only
      technology 'hooks.server.ts'
      description '''
        Runs on every request, in order: read the session (and roll a remembered cookie),
        apply the access gate, count activity, resolve, invalidate the cached snapshot after
        a change, write the admin audit entry. `init` runs once at start: migrations, the
        .env admin, rules, the Faction Studio seed, zones and the weather timer.
      '''
      metadata {
        code 'app/src/hooks.server.ts'
      }
    }

    server = layer 'Server modules' {
      description 'Server-only domain modules ($lib/server). Never imported by a component.'

      access = module 'Access gate' {
        #server-only #pure
        technology 'access.ts'
        description '''
          Who may reach what, in either mode (ACCESS=open|private): one pure decision
          (`accessFor`, `landingFor`) for every request, tested case by case.
        '''
        metadata {
          code 'app/src/lib/server/access{,.spec}.ts'
        }
      }

      accounts = module 'Accounts and sign-in' {
        #server-only
        technology 'auth.ts · signin.ts · passwords.ts · admin-sync.ts · safe-next.ts'
        description '''
          Sessions and cookies (rolling 30 days, remember me), the two sign-in doors (/login
          for players, /admin/login for the CM, signin.ts), scrypt hashing and rate limiters,
          the .env admin re-applied at start, and the safe `next` after sign-in.
        '''
        metadata {
          code 'app/src/lib/server/{auth,signin,passwords,admin-sync,safe-next}{,.spec}.ts'
        }
      }

      requests = module 'Account requests' {
        #server-only
        technology 'requests.ts · request-rules.ts'
        description 'Sign-up and password-reset requests, held until the Campaign Master approves, declines or resolves them.'
        metadata {
          code 'app/src/lib/server/{requests,request-rules}{,.spec}.ts'
        }
      }

      campaign = module 'Campaign and battles' {
        #server-only
        technology 'campaign.ts · games.ts · muster.ts · rounds.ts'
        description '''
          The campaign state replayed from its events, battles (preview and commit), stages,
          seats, invites and Vision deals (muster), and rounds of battles taken one locked
          step at a time.
        '''
        metadata {
          code 'app/src/lib/server/{campaign,games,muster,rounds}{,.spec}.ts'
        }
      }

      warbands = module 'Warbands and rosters' {
        #server-only
        technology 'warbands.ts · roster.ts · builder.ts · sheet.ts · tc-import.ts'
        description 'The warband form, units and stash, the builder (campaign warbands and players\' own lists), the game sheet, and importing a Trench Companion warband.'
        metadata {
          code 'app/src/lib/server/{warbands,roster,builder,sheet,tc-import,aftermath}{,.spec}.ts'
        }
      }

      live = module 'Live snapshot' {
        #server-only
        technology 'public.ts · snapshot-cache.ts · hub.ts'
        description '''
          The public snapshot (the only campaign view that leaves the server; Vision cards stay
          out), cached once per change in Redis, and the hub that fans changes and one-shot
          effects out to every stream and every instance.
        '''
        metadata {
          code 'app/src/lib/server/{public,snapshot-cache,hub}{,.spec}.ts'
        }
      }

      world = module 'Map, weather and lore' {
        #server-only
        technology 'map.ts · fx.ts · lore.ts'
        description 'The map image and zones, weather and effects (regional events, battle results), zone lore.'
        metadata {
          code 'app/src/lib/server/{map,fx,lore}{,.spec}.ts'
        }
      }

      rules = module 'Rules and Faction Studio' {
        #server-only
        technology 'rules-data.ts · packs.ts · studio.ts · factions.ts · starter.ts · versions.ts · editions.ts'
        description 'Rules from the books (book packs read from the group\'s own copies, or the import-rules.py file), the Faction Studio\'s own factions and house rules, the committed starter pack, and the rules versions every load or edit makes.'
        metadata {
          code 'app/src/lib/server/{rules-data,studio,factions,starter,packs,versions,editions}{,.spec}.ts'
        }
      }

      uploads = module 'Files' {
        #server-only
        technology 'uploads.ts · models.ts · unit-art.ts'
        description 'Images re-encoded to WebP, rendered model tokens with their STL sources, and unit art, on the data volume.'
        metadata {
          code 'app/src/lib/server/{uploads,models,unit-art}{,.spec}.ts'
        }
      }

      backup = module 'Backup' {
        #server-only #cm-only
        technology 'backup.ts'
        description 'Export, restore and fresh start of a whole campaign (versioned; older backups still import).'
        metadata {
          code 'app/src/lib/server/backup{,.spec}.ts'
        }
      }

      audit = module 'Audit and activity' {
        #server-only
        technology 'audit.ts · activity.ts · activity-rules.ts'
        description 'The account and admin log, the client address (behind a proxy or not), and per-user daily request counts.'
        metadata {
          code 'app/src/lib/server/{audit,activity,activity-rules}{,.spec}.ts'
        }
      }

      stores = module 'Store adapters' {
        #server-only
        technology 'db/ · redis.ts · kv.ts'
        description 'The Drizzle schema and connection, Redis connections, and the small key-value store (Redis, or memory without REDIS_URL).'
        metadata {
          code ['app/src/lib/server/db/**', 'app/src/lib/server/{redis,kv}{,.spec}.ts']
        }
      }
    }
  }

  // The request pipeline
  cf.app.hooks -> cf.app.server.access 'decides every request'
  cf.app.hooks -> cf.app.server.accounts 'reads the session'
  cf.app.hooks -> cf.app.server.audit 'logs admin actions, counts activity'
  cf.app.hooks -> cf.app.server.live 'invalidates the snapshot after a change'
  cf.app.hooks -> cf.app.server.world 'starts the weather timer'
  cf.app.hooks -> cf.app.server.rules 'loads rules and studio factions at start'
  cf.app.hooks -> cf.app.server.stores 'migrates at start'
  cf.app.hooks -> cf.app.server.campaign 'prepares the campaign at start'

  // Between server modules
  cf.app.server.accounts -> cf.app.server.access 'lands a signed-in user where they may go'
  cf.app.server.accounts -> cf.app.server.audit 'records sign-ins'
  cf.app.server.accounts -> cf.app.server.stores 'sessions, accounts, limits'
  cf.app.server.requests -> cf.app.server.accounts 'hashes passwords, ends sessions'
  cf.app.server.requests -> cf.app.server.stores 'requests'
  cf.app.server.campaign -> cf.app.server.stores 'campaign records, round locks'
  cf.app.server.campaign -> cf.app.server.accounts 'seats get accounts through invites'
  cf.app.server.campaign -> cf.app.server.world 'battles move the weather'
  cf.app.server.campaign -> cf.app.server.requests 'account rules for invite sign-ups'
  cf.app.server.campaign -> cf.app.server.live 'announces changes'
  cf.app.server.warbands -> cf.app.server.stores 'units and stash'
  cf.app.server.warbands -> cf.app.server.rules 'unit and item rules'
  cf.app.server.warbands -> cf.app.server.campaign 'the campaign a warband plays in'
  cf.app.server.warbands -> cf.app.server.accounts 'who may edit a list'
  cf.app.server.warbands -> cf.app.server.live 'announces an imported roster'
  cf.app.server.live -> cf.app.server.campaign 'builds the snapshot from the campaign state'
  cf.app.server.live -> cf.app.server.world 'map, zones and weather in the snapshot'
  cf.app.server.live -> cf.app.server.warbands 'rosters in the snapshot'
  cf.app.server.live -> cf.app.server.stores 'snapshot cache, pub/sub'
  cf.app.server.live -> cf.app.server.uploads 'model tokens in the snapshot'
  cf.app.server.world -> cf.app.server.stores 'zones, weather, lore'
  cf.app.server.world -> cf.app.server.live 'pushes effects to every screen'
  cf.app.server.world -> cf.app.server.campaign 'battle results for the effects'
  cf.app.server.world -> cf.app.server.rules 'the starter map for a new campaign'
  cf.app.server.world -> cf.app.server.uploads 'the map image'
  cf.app.server.rules -> cf.app.server.stores 'rules and studio rows'
  cf.app.server.rules -> cf.app.server.live 'reloads factions on every instance'
  cf.app.server.rules -> cf.app.server.world 'weather presets in the starter pack'
  cf.app.server.uploads -> cf.app.server.stores 'model and art records'
  cf.app.server.backup -> cf.app.server.stores 'reads and writes everything'
  cf.app.server.backup -> cf.app.server.uploads 'files in the backup'
  cf.app.server.audit -> cf.app.server.stores 'audit log, activity'

  // Out to the services
  cf.app.server.stores -[writes]-> cf.db 'SQL'
  cf.app.server.stores -> cf.redis 'cache, limits, pub/sub, locks'
  cf.app.server.uploads -[writes]-> cf.files 'WebP, PNG, STL'
}
