// What PostgreSQL holds (app/src/lib/server/db/schema.ts), in groups. Each table is listed in generated/tables.c4.
model {
  extend cf.db {
    t_campaign = layer 'Campaign' {
      description 'The campaign and its stages, seats, warbands, battles, adjustments, rounds, challenges and invites.'
      metadata {
        tables ['campaign', 'player', 'warband', 'game', 'adjustment', 'round', 'round_entry', 'challenge', 'invite']
      }
    }
    t_map = layer 'Map and weather' {
      description 'Zones, their lore, regional weather and the effects state.'
      metadata {
        tables ['map_zone', 'zone_lore', 'region_weather', 'fx_state']
      }
    }
    t_rosters = layer 'Rosters' {
      description 'Units, stash, rendered model tokens and unit art.'
      metadata {
        tables ['unit', 'warband_stash', 'model', 'unit_art']
      }
    }
    t_rules = layer 'Rules' {
      description 'Rules imported from the books and the Faction Studio\'s own.'
      metadata {
        tables ['rules_unit', 'rules_item', 'rules_keyword', 'rules_faction', 'rules_page', 'rules_patron', 'custom_faction']
      }
    }
    t_accounts = layer 'Accounts' {
      description 'Accounts, sessions, sign-up and reset requests, the audit log and daily activity.'
      metadata {
        tables ['user', 'session', 'account_request', 'audit_log', 'user_activity']
      }
    }
  }

  cf.app.server.campaign -[writes]-> cf.db.t_campaign
  cf.app.server.world -[writes]-> cf.db.t_map
  cf.app.server.warbands -[writes]-> cf.db.t_rosters
  cf.app.server.uploads -[writes]-> cf.db.t_rosters 'models, unit art'
  cf.app.server.rules -[writes]-> cf.db.t_rules
  cf.app.server.accounts -[writes]-> cf.db.t_accounts 'users, sessions'
  cf.app.server.requests -[writes]-> cf.db.t_accounts 'requests'
  cf.app.server.audit -[writes]-> cf.db.t_accounts 'audit log, activity'
}
