// Who uses Carcass Front, and the services it runs as (compose.yaml).
model {
  guest = actor 'Guest' {
    description 'Anyone watching the campaign: a phone at the table, the TV. Only in open mode (ACCESS=open).'
  }
  player = actor 'Player' {
    description 'Signs in at /login; builds and keeps their warband, plays the round.'
  }
  cm = actor 'Campaign Master' {
    description 'Signs in at /admin/login; runs the campaign from the admin console.'
  }

  cf = system 'Carcass Front' {
    description '''
      A live campaign tracker for Trench Crusade: the map, warbands, rounds of battles and
      the weather over them. One SvelteKit app, PostgreSQL for every record, Redis for
      what is shared between instances.
    '''

    app = service 'App' {
      technology 'SvelteKit 2 · Svelte 5 · adapter-node · PixiJS 8'
      description 'The app container: server, pages and the live map. Graceful shutdown on SIGTERM; health at /health.'
      metadata {
        services ['carcass-front']
        code ['app/server.js', 'app/src/app.d.ts']
      }
    }

    db = store 'PostgreSQL' {
      technology 'Postgres 17 · Drizzle'
      description 'Every campaign record, account, session, rule and log. Migrations in app/drizzle, applied at start under a startup lock.'
      metadata {
        services ['db', 'pgdata']
      }
    }

    redis = store 'Redis' {
      technology 'Redis 7'
      description 'Snapshot and session caches, rate-limit counters, cross-instance live updates, the startup and weather locks. Nothing durable: rebuilt from Postgres.'
      metadata {
        services ['redis']
      }
    }

    files = store 'Uploads' {
      technology 'docker volume'
      description 'Uploaded maps, portraits, symbols, seals, model tokens and their STL sources (/data/uploads).'
      metadata {
        services ['data']
      }
    }

    caddy = service 'Caddy' {
      technology 'Caddy 2 · profile https'
      description 'TLS for DOMAIN; passes the client address in X-Forwarded-For. Only with COMPOSE_PROFILES=https.'
      metadata {
        services ['caddy', 'caddy_data', 'caddy_config']
      }
    }
  }

  guest -> cf.caddy 'watches the map' 'HTTPS'
  player -> cf.caddy 'plays' 'HTTPS'
  cm -> cf.caddy 'runs the campaign' 'HTTPS'
  cf.caddy -> cf.app.hooks 'proxies to :3000' 'HTTP'
  cf.app -[writes]-> cf.db 'every record' 'SQL'
  cf.app -> cf.redis 'caches, limits, pub/sub, locks'
  cf.app -[writes]-> cf.files 'uploads'
}
