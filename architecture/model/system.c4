// Forgotten Letters: who uses it, the containers it runs as, and the layers inside the app.
// Layers point one way: web (routes) -> services -> repos -> tables; infra and the shared lib are used by all.
model {
  owner = actor 'Owner' {
    description 'Runs the copy for the group: invites admins and users, changes roles, disables accounts, resets passwords, keeps backups.'
  }
  admin = actor 'Admin (Campaign Master)' {
    description 'Runs campaigns; invites players. Can also play.'
  }
  user = actor 'User (player)' {
    description 'Plays warbands and follows the campaign.'
  }
  visitor = actor 'Visitor' {
    description 'Not signed in: sees the welcome and setup pages on a fresh install, then the sign-in, invite and help pages.'
  }

  fl = system 'Forgotten Letters' {
    description 'A self-hosted campaign companion for Trench Crusade, one copy per gaming group.'

    app = service 'app' {
      technology 'Node 26 · SvelteKit 3 (adapter-node)'
      description 'Serves pages, form actions, the JSON API and health checks. On start: migrations (after a dump), "setup is open" in the log while there is no owner, listening on the stored port, background jobs.'
      metadata {
        services ['app', 'uploads', 'backups']
      }

      server = module 'Custom server' {
        #server-only
        technology 'node server · node:http around build/handler.js'
        description 'Starts the built app and owns its listeners, so the port stored in settings can change while running: open the new port, then close the old one. Docker runs it with PORT_LOCKED=1.'
        metadata {
          code 'app/server/**'
        }
      }

      hooks = module 'Request pipeline' {
        #server-only
        technology 'hooks.server.ts'
        description 'Start-up (migrations, setup notice, listen on the stored port, jobs), then for every request: request id, readiness gate, setup guard (to /welcome while there is no owner), session, access log, error mapping.'
        metadata {
          code 'app/src/hooks.server.ts'
        }
      }

      web = layer 'Web (routes)' {
        description 'Pages, form actions and API endpoints. They parse input with zod and call one service; no SQL here.'

        publicPages = page 'Welcome, setup, sign-in, invite and help pages' {
          technology '/welcome · /setup · /login · /invite/[token] · /help/[page] · /logout'
          description 'The welcome page and four-step setup wizard on a fresh install (Owner, Look, Server, Done); the one sign-in screen for every role, in the same split as the welcome page; joining by invite; help and legal placeholder pages.'
          metadata {
            code ['app/src/routes/(public)/**', 'app/src/routes/logout/**']
          }
        }
        areas = page 'App shell, role areas and account' {
          technology '/owner · /owner/settings · /admin · /home · /account'
          description 'The shell: a top bar (Docs, user menu with User settings and Log out) and a sliding left panel with the areas the person can use and the help and legal links. Each role lands in its own area; the Owner changes text size, accent and port under /owner/settings.'
          metadata {
            code ['app/src/routes/(app)/**', 'app/src/routes/+layout*', 'app/src/routes/+page*', 'app/src/routes/+error.svelte']
          }
        }
        api = endpoint 'JSON API v1' {
          technology '/api/v1 · openapi.json'
          description 'The same actions as the pages, authenticated by the session cookie; documented by an OpenAPI document.'
          metadata {
            code 'app/src/routes/api/**'
          }
        }
        health = endpoint 'Health' {
          technology '/health/live · /health/ready'
          description 'Liveness for Docker; readiness (database and migrations) for proxies and smoke tests.'
          metadata {
            code 'app/src/routes/health/**'
          }
        }
      }

      ui = module 'Components and look' {
        #client
        technology 'Svelte 5 · tokens.css · Bits UI · anime.js'
        description 'The design system in code: tokens and accent presets, fonts, glass buttons and form controls, the emblem, skeletons, the anime.js motion helpers, the message file.'
        metadata {
          code ['app/src/lib/ui/**', 'app/src/lib/messages.ts', 'app/src/app.html', 'app/src/app.d.ts']
        }
      }

      shared = module 'Shared lib' {
        #pure
        technology 'roles · zod schemas · API types'
        description 'Pure code used by pages, the API and services: role ranks and can(), input schemas, API types.'
        metadata {
          code ['app/src/lib/roles.ts', 'app/src/lib/schemas/**', 'app/src/lib/api-types.ts', 'app/src/lib/index.ts', 'app/src/lib/*.spec.ts']
        }
      }

      services = layer 'Services' {
        description 'Business rules. They validate what they change, run transactions, write the audit log and throw AppError.'

        authService = module 'Sign-in and sessions' {
          #server-only
          description 'Sign in and out, sessions (create, read, slide, end), password changes, the sign-in rate limit.'
          metadata {
            code ['app/src/lib/server/services/auth{,.spec,.db.spec}.ts', 'app/src/lib/server/services/passwords{,.spec,.db.spec}.ts']
          }
        }
        setupService = module 'First-run setup' {
          #server-only
          description 'Setup is open while no owner exists (Jellyfin style). One transaction creates the first owner, saves the chosen text size, accent and port, marks setup done and signs the owner in; a second attempt is refused.'
          metadata {
            code 'app/src/lib/server/services/setup{,.spec,.db.spec}.ts'
          }
        }
        settingsService = module 'Instance settings' {
          #server-only
          description 'Reads and changes the copy-wide settings (text size, accent, port). A port change asks the custom server to move and answers with the new address; refused when the port is locked (Docker, dev).'
          metadata {
            code 'app/src/lib/server/services/settings{,.spec,.db.spec}.ts'
          }
        }
        peopleService = module 'People' {
          #server-only
          description 'Lists accounts by role, changes roles (last owner kept), disables, resets and anonymises accounts, display names.'
          metadata {
            code 'app/src/lib/server/services/people{,.spec,.db.spec}.ts'
          }
        }
        inviteService = module 'Invites' {
          #server-only
          description 'Create, list, revoke and accept invites; accepting runs once under a row lock.'
          metadata {
            code 'app/src/lib/server/services/invites{,.spec,.db.spec}.ts'
          }
        }
        auditService = module 'Audit log' {
          #server-only
          description 'Records sign-ins, invites, role changes, disables and resets; the owner reads it.'
          metadata {
            code 'app/src/lib/server/services/audit{,.spec,.db.spec}.ts'
          }
        }
        backupService = module 'Backups' {
          #server-only
          description 'pg_dump before migrations and daily (14 days kept); owner download and restore.'
          metadata {
            code 'app/src/lib/server/services/backups{,.spec,.db.spec}.ts'
          }
        }
      }

      repos = module 'Repos' {
        #server-only
        technology 'Drizzle ORM'
        description 'The only place with SQL: one module per table group, taking a db or a transaction.'
        metadata {
          code 'app/src/lib/server/repos/**'
        }
      }

      infra = module 'Infra' {
        #server-only
        technology 'zod config · postgres.js pool · pino · in-memory limits · jobs · migrations · listener control'
        description 'Settings, the database pool, logging, errors and the HTTP helpers, rate limits, background jobs, migrations, and the bridge to the custom server that moves the port.'
        metadata {
          code ['app/src/lib/server/infra/**', 'app/src/lib/server/errors{,.spec,.db.spec}.ts', 'app/src/lib/server/http/**', 'app/src/lib/server/db/index.ts', 'app/src/lib/server/jobs.ts', 'app/src/lib/server/testing/**']
        }
      }

      authTables = layer 'auth schema' {
        description 'Accounts, sessions, invites and the audit log.'
        metadata {
          tables ['users', 'sessions', 'invites', 'audit_log']
          code ['app/src/lib/server/db/schema{,.db.spec}.ts', 'app/drizzle/**', 'app/drizzle.config.ts']
        }
      }

      appTables = layer 'app schema' {
        description 'Copy-wide settings: one row with text size, accent, port and when setup was completed.'
        metadata {
          tables ['settings']
        }
      }
    }

    db = store 'PostgreSQL 18' {
      technology 'postgres:18'
      description 'All data, on a named volume.'
      metadata {
        services ['db', 'pgdata']
      }
    }

    caddy = service 'Caddy (optional)' {
      technology 'caddy:2 · compose profile https'
      description 'HTTPS certificate for a server deployment; off on a LAN.'
      metadata {
        services ['caddy', 'caddy_data', 'caddy_config']
      }
    }
  }

  owner -> fl.app.web 'manages people, invites, backups'
  admin -> fl.app.web 'invites players'
  user -> fl.app.web 'signs in, manages own account'
  visitor -> fl.app.web.publicPages 'sets up a fresh copy, signs in, joins, reads help'
  fl.caddy -> fl.app 'forwards HTTPS'
  fl.app.server -> fl.app.hooks 'loads the built app, which reports the stored port'

  fl.app.hooks -> fl.app.services 'resolves the session, runs start-up'
  fl.app.hooks -> fl.app.infra 'request ids, readiness, errors'
  fl.app.web -> fl.app.services 'calls'
  fl.app.web -> fl.app.shared 'parses input'
  fl.app.web -> fl.app.ui 'renders'
  fl.app.web -> fl.app.infra 'form and API helpers'
  fl.app.services -> fl.app.repos 'reads and writes'
  fl.app.services -> fl.app.infra 'config, logging, transactions'
  fl.app.services -> fl.app.shared 'roles, schemas'
  fl.app.services.authService -> fl.app.services.auditService 'records sign-ins'
  fl.app.services.peopleService -> fl.app.services.auditService 'records changes'
  fl.app.services.peopleService -> fl.app.services.authService 'ends sessions'
  fl.app.services.inviteService -> fl.app.services.auditService 'records invites'
  fl.app.services.inviteService -> fl.app.services.authService 'signs the new account in'
  fl.app.services.setupService -> fl.app.services.authService 'hashes, signs in'
  fl.app.services.setupService -> fl.app.services.auditService 'records the first owner'
  fl.app.services.setupService -> fl.app.services.settingsService 'saves the chosen look and port'
  fl.app.services.settingsService -> fl.app.services.auditService 'records settings changes'
  fl.app.services.settingsService -> fl.app.services.authService 'only the owner may change settings'
  fl.app.hooks -> fl.app.shared 'text-size bounds for the first paint'
  fl.app.authTables -> fl.app.shared 'the accent presets and bounds behind the check constraints'
  fl.app.services.backupService -> fl.app.services.auditService 'records downloads and restores'
  fl.app.repos -> fl.app.authTables 'SQL'
  fl.app.repos -> fl.app.appTables 'SQL'
  fl.app.repos -> fl.app.infra 'pool'
  fl.app.ui -> fl.app.shared 'roles'
  fl.app.ui -> fl.app.services.auditService 'the Ctx and SessionUser types in app.d.ts'
  fl.app.infra -> fl.app.authTables 'the pool knows the schema; migrations'
  fl.app.infra -> fl.app.services.auditService 'the Ctx and SessionUser types for request context'
  fl.app.infra -> fl.app.shared 'API types for the OpenAPI document'
  fl.app.infra -> fl.app.repos 'hourly cleanup of sessions, invites and old audit rows'
  fl.app.infra -> fl.app.services.backupService 'daily backup and pruning job'
  fl.app.authTables -> fl.db 'stored in'
  fl.app.appTables -> fl.db 'stored in'
  fl.app.infra -> fl.app.server 'asks it to listen on a new port'
  fl.app.infra -> fl.db 'pool, migrations, dumps'
}
