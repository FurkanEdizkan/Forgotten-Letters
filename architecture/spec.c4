// The vocabulary of the model. Elements point at the code through metadata (read by tools/atlas):
//   code ['path', 'glob/**']   files the element is made of (the most specific pattern owns a file)
//   tables ['name', …]          Drizzle tables a table group holds
//   services ['name', …]        compose services and volumes the element is
specification {
  element actor {
    style {
      shape person
      color secondary
    }
  }
  element system {
    style {
      color primary
    }
  }
  element service {
    style {
      color primary
    }
  }
  element store {
    style {
      shape storage
      color muted
    }
  }
  element layer {
    style {
      color slate
      opacity 10%
    }
  }
  element module {
    style {
      color sky
    }
  }
  element page {
    style {
      shape browser
      color indigo
    }
  }
  element endpoint {
    style {
      color amber
      size small
    }
  }
  element table {
    style {
      shape storage
      color gray
      size small
    }
  }

  tag pure
  tag server-only
  tag client
  tag cm-only

  relationship imports {
    line dotted
    color gray
  }
  relationship reads
  relationship writes
  relationship streams {
    line dashed
    color green
  }
}
