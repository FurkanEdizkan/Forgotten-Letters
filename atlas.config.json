{
	"model": "architecture",
	"title": "Carcass Front architecture",
	"base": "main",
	"extract": {
		"imports": ["app/src/**/*.ts", "app/src/**/*.svelte", "app/server.js"],
		"alias": { "$lib": "app/src/lib" },
		"sveltekit": "app/src/routes",
		"drizzle": "app/src/lib/server/db/schema.ts",
		"compose": "compose.yaml"
	}
}
